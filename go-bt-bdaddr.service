[Unit]
Description=Flash deterministic BLE BD_ADDR derived from end0 MAC
Documentation=https://github.com/GOcontroll/go-bt
ConditionPathExists=/sys/class/net/end0

[Service]
# Type=simple matches what `systemd-run` uses for its transient units.
# The btmgmt hang once blamed on `Type=oneshot` is btmgmt blocking on the
# /dev/null stdin systemd gives every service; go-bt-bdaddr.sh feeds it
# an open pipe instead.
Type=simple
ExecStart=/usr/local/sbin/go-bt-bdaddr.sh

[Install]
WantedBy=multi-user.target
